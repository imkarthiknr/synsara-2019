# Copy to .env and adjust. Every value is optional for local development.

# SQLite by default. PostgreSQL example: postgresql+psycopg://synsara:secret@localhost:5432/synsara
DATABASE_URL=sqlite:///./data/synsara.db

# Signs the admin session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Set to false to show "registrations closed" instead of the forms.
REGISTRATION_OPEN=true

# Where hackathon abstracts are stored, and the size limit in MB.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# Another edition's content file (events, dates, rules).
# SYNSARA_CONTENT=content/synsara-2019.yaml

# Docker Compose only
POSTGRES_PASSWORD=change-me
